{
  "name": "imqueue.com",
  "version": "1.0.0",
  "description": "You may visit this site at [imqueue.com](https://imqueue.com/)",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@microsoft/api-documenter": "^7.25.0",
    "@microsoft/api-extractor": "^7.47.0",
    "@types/node": "^25.9.5",
    "js-yaml": "^4.3.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-table-of-contents": "^0.9.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~5.8.0",
    "wawoff2": "^2.0.1"
  },
  "overrides": {
    "@microsoft/api-documenter": {
      "js-yaml": "^4.3.1"
    },
    "@microsoft/api-extractor": {
      "brace-expansion": "^5.0.9"
    },
    "@11ty/eleventy": {
      "brace-expansion": "^2.0.2"
    }
  },
  "scripts": {
    "test": "npm run check:redirects && npm run check:agent-analytics && npm run check:dates && npm run check:package-status && npm run check:links && npm run check:sitemap && npm run check:llms && npm run check:search-ranker && npm run check:search-index && npm run check:search-ranking && npm run check:kpi && npm run check:search-ui && npm run check:jsonld && npm run check:mermaid",
    "check:redirects": "node scripts/check-redirects.js",
    "check:agent-analytics": "node scripts/check-agent-analytics.js",
    "probe:agent-analytics": "node scripts/probe-agent-analytics.js",
    "check:dates": "node scripts/gen-page-dates.js --check",
    "check:package-status": "node scripts/check-package-status.js",
    "check:package-status:npm": "node scripts/gen-package-status.js --check",
    "check:ranker-engine": "node scripts/check-ranker-engine.js",
    "check:sitemap": "node scripts/check-sitemap.js",
    "check:llms": "node scripts/check-llms.js",
    "check:search-ranker": "node scripts/check-search-ranker.js",
    "check:search-index": "node scripts/check-search-index.js _site-org && node scripts/check-search-index.js _site-com",
    "check:search-ranking": "node scripts/check-search-ranking.js",
    "check:search-ui": "node scripts/check-search-ui.js",
    "check:kpi": "node scripts/check-kpi.js",
    "check:kpi:labels": "node scripts/check-kpi.js --labels-only",
    "kpi": "node scripts/search-kpi/gold.js",
    "kpi:build": "node scripts/search-kpi/build-gold.js",
    "kpi:worst": "node scripts/search-kpi/gold.js --worst 40",
    "kpi:topic": "node scripts/search-kpi/gold.js --topic",
    "kpi:source": "node scripts/search-kpi/gold.js --source",
    "kpi:baseline": "node scripts/search-kpi/gold.js --json scripts/search-kpi/data/gold-baseline.json",
    "kpi:compare": "node scripts/search-kpi/compare.js",
    "kpi:tripwire": "node scripts/search-kpi/measure.js",
    "kpi:search": "node scripts/search-kpi/gold.js && node scripts/search-kpi/measure.js",
    "kpi:search:harvest": "node scripts/search-kpi/harvest-natural.js",
    "kpi:search:gen": "node scripts/search-kpi/gen-artificial.js --count 10000",
    "gen-search-index": "node scripts/gen-search-index.js",
    "check:jsonld": "node scripts/check-jsonld.js",
    "check:mermaid": "node scripts/check-mermaid.js",
    "check:geo-live": "node scripts/check-geo-live.js",
    "check:api-versions": "node scripts/check-api-versions.js",
    "check:links": "npm run build:all && node scripts/check-links.js",
    "check:links:external": "npm run build:all && node scripts/check-links.js --external --allow-external=scripts/external-allowlist.txt",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "edition:org": "EDITION=org eleventy",
    "edition:com": "EDITION=com eleventy",
    "build:org": "node scripts/build-site.js org",
    "build:com": "node scripts/build-site.js com",
    "build:all": "npm run edition:org && npm run edition:com && node scripts/copy-peer-index.js",
    "serve:org": "EDITION=org eleventy --serve --port=${PORT:-8080}",
    "serve:com": "EDITION=com eleventy --serve --port=${PORT:-8081}",
    "build": "npm run build:all",
    "gen-brand-badges": "node scripts/gen-brand-badges.mjs",
    "gen-favicons": "node scripts/gen-favicons.mjs",
    "gen-og": "node scripts/gen-og-images.js",
    "gen-og-blog": "node scripts/gen-og-blog.js",
    "gen-page-dates": "node scripts/gen-page-dates.js",
    "gen-package-status": "node scripts/gen-package-status.js",
    "build-docs": "node scripts/build-api-docs.js",
    "gen-api-crosslinks": "node scripts/gen-api-crosslinks.js",
    "backfill-api-descriptions": "node scripts/backfill-api-descriptions.js",
    "sync-cli-guide": "node scripts/sync-cli-wiki.js",
    "sync-cli-guide:check": "node scripts/sync-cli-wiki.js --check",
    "indexnow:org": "node scripts/indexnow-ping.js org --exclude=/api/",
    "indexnow:com": "node scripts/indexnow-ping.js com",
    "gen-syndication": "node scripts/gen-syndication.js",
    "gen-social": "node scripts/gen-social-preview.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imqueue/imqueue.com.git"
  },
  "author": "Mykhailo Stadnyk <mikhus@gmail.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/imqueue/imqueue.com/issues"
  },
  "homepage": "https://github.com/imqueue/imqueue.com#readme"
}
