#!/bin/sh
#
# @imqueue.com pre-commit hook.
#
#   1. Cloudflare redirect checks — the dynamic-rule budget (Pages silently drops
#      _redirects rules past the 100th) and the /api/ version mapping.
#   2. Rebuild both editions and crawl for broken links. Blocks the commit if any
#      internal link (page, asset, cross-site .org<->.com, or #anchor) fails.
#
# Wired via `git config core.hooksPath .githooks` (done automatically by the
# `prepare` npm script on `npm install`).
#
# Bypass in a genuine emergency with:  git commit --no-verify
#
set -e

# Only run in the imqueue.com site repo (the hooks dir is shared via hooksPath).
if [ ! -f "scripts/check-links.js" ]; then
  exit 0
fi

echo "→ pre-commit: checking Cloudflare redirects…"
if ! npm run --silent check:redirects; then
  echo "" >&2
  echo "✗ Redirect checks failed — commit aborted." >&2
  echo "  Bypass in an emergency with: git commit --no-verify" >&2
  exit 1
fi

echo "→ pre-commit: building sites and checking for broken links…"
if ! npm run --silent check:links; then
  echo "" >&2
  echo "✗ Broken links found — commit aborted." >&2
  echo "  Fix the links above, or bypass with: git commit --no-verify" >&2
  exit 1
fi
