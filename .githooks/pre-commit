#!/bin/sh
#
# @imqueue.com pre-commit hook.
#
#   1. Cloudflare redirect checks — the dynamic-rule budget (Pages silently drops
#      _redirects rules past the 100th) and the /api/ version mapping.
#   2. Agent analytics — lib/agent-analytics.ts and the root _middleware that
#      carries it. Every invariant there fails silently (a bot-filtered dataset, a
#      duplicated property) except one, which fails loudly for both whole sites.
#   3. Page dates — every page still has a recorded publication date, and none of
#      them drifted.
#   4. Rebuild both editions and crawl for broken links. Blocks the commit if any
#      internal link (page, asset, cross-site .org<->.com, or #anchor) fails.
#   5. Sitemap — no duplicate, unbuilt, noindex or missing URLs across the index
#      and its children, and the markdown mirror /agents/ promises for every page.
#
# These must stay in the same order as `npm test`, which is what CI runs
# (.github/workflows/checks.yml). Steps 2 and 4 were missing here for a while, so
# they only ran if someone typed `npm test` by hand; CI is the real backstop now,
# since this hook never runs for a commit made through the GitHub UI or by the
# sync-cli-guide bot. Run as separate steps rather than one `npm test` so a slow
# hook reports progress and the fast checks fail first.
#
# Wired via `git config core.hooksPath .githooks` (done automatically by the
# `prepare` npm script on `npm install`).
#
# Bypass in a genuine emergency with:  git commit --no-verify
#
set -e

# Only run in the imqueue.com site repo (the hooks dir is shared via hooksPath).
#
# THE PROBE FILE HAS TO EXIST, and this one silently stopped existing: it named
# scripts/check-links.js, which the TypeScript migration renamed to .ts, so the test
# was false in the one repo the hook is for and every check below was skipped on
# every commit. A hook that exits 0 for the wrong reason is worse than no hook —
# nothing reports it, and the failure it was guarding lands in CI instead.
if [ ! -f "scripts/check-links.ts" ]; then
  exit 0
fi

echo "→ pre-commit: checking Cloudflare redirects…"
if ! npm run --silent check:redirects; then
  echo "" >&2
  echo "✗ Redirect checks failed — commit aborted." >&2
  echo "  Bypass in an emergency with: git commit --no-verify" >&2
  exit 1
fi

echo "→ pre-commit: checking the agent-analytics middleware…"
if ! npm run --silent check:agent-analytics; then
  echo "" >&2
  echo "✗ Agent-analytics checks failed — commit aborted." >&2
  echo "  This guards functions/_middleware.ts, which runs in front of EVERY" >&2
  echo "  request to both sites. Read the failure before bypassing." >&2
  echo "  Bypass in an emergency with: git commit --no-verify" >&2
  exit 1
fi

echo "→ pre-commit: checking page dates…"
if ! npm run --silent check:dates; then
  echo "" >&2
  echo "✗ Page dates are stale — commit aborted." >&2
  echo "  Run: npm run gen-page-dates && git add src/_data/pageDates.json" >&2
  echo "  Bypass in an emergency with: git commit --no-verify" >&2
  exit 1
fi

echo "→ pre-commit: building sites and checking for broken links…"
if ! npm run --silent check:links; then
  echo "" >&2
  echo "✗ Broken links found — commit aborted." >&2
  echo "  Fix the links above, or bypass with: git commit --no-verify" >&2
  exit 1
fi

echo "→ pre-commit: checking the sitemap…"
if ! npm run --silent check:sitemap; then
  echo "" >&2
  echo "✗ Sitemap checks failed — commit aborted." >&2
  echo "  Bypass in an emergency with: git commit --no-verify" >&2
  exit 1
fi
