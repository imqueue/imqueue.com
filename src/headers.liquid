# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The site publishes AI-agent-facing plain-markdown mirrors of its pages
# (<page-url>index.md), a curated /llms.txt index and a concatenated
# /llms-full.txt. They intentionally duplicate the canonical HTML content, so
# keep them out of search-engine indexes (avoiding duplicate-content issues)
# while leaving them fully fetchable by AI crawlers and agents — robots.txt
# allows them, noindex only stops SERP indexing, not retrieval.

/*.md
  X-Robots-Tag: noindex

/llms.txt
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

# ---- caching -------------------------------------------------------------
# Fonts are the one asset class safe to cache forever unasked: the filenames come
# from @fontsource and encode family, subset and weight, so a given name never
# changes content. Cloudflare's default (max-age=14400) had the browser
# revalidating ~146 KB of immutable woff2 every four hours.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# /css/* and /js/* are now content-hashed at build time (base.css ->
# base.<hash>.css, see scripts/lib/asset-manifest.js), which is the prerequisite
# this comment used to ask for. A changed file is a new URL, so `immutable` cannot
# pin stale bytes — the previous max-age=14400 on unfingerprinted names could, and
# did: on 2026-07-30 a deployed CSS fix kept being served from the old edge copy
# for hours while the canonical URL looked fine.
#
# Safe as a wildcard specifically because the build emits NO unhashed copy. If you
# ever reintroduce a plain /css/<name>.css, this header would cache it for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# ---- security ------------------------------------------------------------
# Not ranking factors, but cheap and worth having. Left out on purpose:
#   * Strict-Transport-Security — a year-long max-age is effectively
#     irreversible, and it is a deployment decision rather than an SEO one.
#     Enable it once you are certain every subdomain (mcp.imqueue.org included)
#     is HTTPS-only:  Strict-Transport-Security: max-age=31536000
#   * Content-Security-Policy — this site runs inline scripts (the no-FOUC theme
#     init) plus GA4 and Clarity, so a policy needs to be authored and tested
#     against real pages rather than pasted in.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
