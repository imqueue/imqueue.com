# imqueue.com is the commercial edition; all documentation and open-source
# content now lives on imqueue.org. 301 the legacy imqueue.com content paths to
# their new home so inbound links and search rankings carry over.
#
# Note: /api/contact and /api/message are Pages Functions, and Functions are
# evaluated BEFORE _redirects, so the /api/* rule below does not affect either mail
# endpoint. That ordering is the only thing keeping them alive on this host — a POST
# that reached the rule would be answered with a 301 to imqueue.org, and a browser
# turns a redirected POST into a GET, so the form would fail with no useful error.
# scripts/check-redirects.js asserts both paths stay unclaimed; add any new
# /api/<name> function to that list too.

/docs           https://imqueue.org/docs/               301
/docs/*         https://imqueue.org/docs/:splat         301
/tutorial       https://imqueue.org/tutorial/           301
/tutorial/*     https://imqueue.org/tutorial/:splat     301
/intro          https://imqueue.org/intro/              301
/intro/*        https://imqueue.org/intro/:splat        301
/get-started    https://imqueue.org/get-started/        301
/get-started/*  https://imqueue.org/get-started/:splat  301
/blog           https://imqueue.org/blog/               301
/blog/*         https://imqueue.org/blog/:splat         301
/api            https://imqueue.org/api/                301
/api/*          https://imqueue.org/api/:splat          301
/cli            https://imqueue.org/cli/                301
/cli/*          https://imqueue.org/cli/:splat          301
/mcp            https://imqueue.org/mcp/                301
/mcp/*          https://imqueue.org/mcp/:splat          301
/agents         https://imqueue.org/agents/             301
/agents/*       https://imqueue.org/agents/:splat       301

# Legacy open-source pages (old British-spelled /licence/ and /contributing/,
# which had no sub-pages) now live on imqueue.org. The old /licence/ maps to the
# refreshed /license/ page there.
/licence        https://imqueue.org/license/            301
/licence/*      https://imqueue.org/license/            301
/contributing   https://imqueue.org/contributing/       301
/contributing/* https://imqueue.org/contributing/       301
